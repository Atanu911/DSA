/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode(int x) : val(x), next(NULL) {}
 * };
 */
class Solution {
public:
    ListNode *getIntersectionNode(ListNode *headA, ListNode *headB) {
        ListNode* temp1 = headA;
        ListNode* temp2 = headB;    
        int len1 = 0;
        while(headA != NULL){
            headA = headA->next;
            len1++;
        }
        int len2 = 0;
        while(headB != NULL){
            headB = headB->next;
            len2++;
        }
        headA = temp1;
        headB = temp2;
        if(len1>len2){
           for(int i = 1;i<=(len1-len2);i++){
                headA = headA->next;
            }
        }
        else{
            for(int i = 1;i<=(len2-len1);i++){
                headB = headB->next;
            }
        }
        while(headA != headB){
            headA = headA->next;
            headB = headB->next;

        }
        return headA;
    }
};
